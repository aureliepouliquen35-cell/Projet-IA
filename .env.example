# Variables d'environnement de Nova Services (AD-15)
#
# Ce fichier est public : il ne contient que des valeurs fictives.
# Pour travailler en local, copiez-le en `.env.local` (jamais envoyé sur
# GitHub) et remplacez chaque valeur par la vraie, prise sur le projet
# Supabase **dev**. La production (Vercel) a ses propres valeurs, celles du
# projet **prod**, saisies dans les réglages de Vercel.
#
# Le préfixe NEXT_PUBLIC_ rend une variable visible dans le navigateur :
# il est réservé aux deux premières, qui ne sont pas secrètes.

# Adresse du projet Supabase.
# Tableau de bord Supabase > Project Settings > Data API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://exemple.supabase.co

# Clé publique (« publishable »), utilisée par le navigateur et le serveur.
# Tableau de bord Supabase > Project Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=exemple-cle-publique

# Clé secrète : donne tous les droits sur la base. Serveur uniquement.
# Tableau de bord Supabase > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=exemple-cle-secrete

# Secret servant à calculer l'empreinte des adresses IP (jamais l'IP en clair).
# À générer soi-même, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRET_EMPREINTE_IP=exemple-secret-empreinte-ip

# Secret servant à signer les cookies passés d'une page à l'autre (AD-20).
# À générer de la même façon, avec une valeur différente de la précédente.
SECRET_COOKIES=exemple-secret-cookies
